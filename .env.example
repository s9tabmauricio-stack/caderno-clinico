# Só é preciso preencher para usar outro projeto do Supabase.
# Os valores do projeto caderno-clinico já estão em lib/supabase/config.ts.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Mostra o botão "Continuar com Google" depois que o Google for ativado no Supabase
NEXT_PUBLIC_LOGIN_GOOGLE=0

# Chave secreta do Supabase (a mesma da Vercel). Só no .env.local do computador
# ou nas variáveis do ambiente do assistente; NUNCA no Git. Usada pelo
# scripts/gravar-rascunho.mjs para gravar flashcards e questões sem o conector.
SUPABASE_SECRET_KEY=

# Token pessoal do Supabase (sbp_...). Usado pelo scripts/sql.mjs, que roda SQL no
# banco sem o conector (o Codex usa). NUNCA no Git. Como criar: docs/codex.md.
SUPABASE_ACCESS_TOKEN=
